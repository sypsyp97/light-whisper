# Shell scripts must keep LF endings
*.sh text eol=lf
# Formal replay provenance hashes these text files byte for byte on every OS.
formal/*.tla text eol=lf
formal/*.cfg text eol=lf
# Raw TLC state blocks retain their final blank separator for provenance hashes.
formal/traces/*.tlc.txt text eol=lf whitespace=-blank-at-eof
# Native runtime manifests hash the reviewed patch byte for byte.
# Unified-diff context lines contain a required leading space, even when blank.
scripts/patches/*.patch text eol=lf whitespace=-blank-at-eol
# Frozen native test snippets retain their final separator in baseline hashes.
scripts/native_tests/device_embeddings_baseline_scaffold.cpp text eol=lf whitespace=-blank-at-eof
# Preserve the upstream license verbatim.
src-tauri/resources/R2T2-MODEL-LICENSE.txt whitespace=-blank-at-eol
