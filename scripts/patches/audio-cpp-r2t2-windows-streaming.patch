+// One bounded prompt allocation. Text stays cached on the host; encoded audio
+// rows are copied directly from the encoder on this same backend.
+class DevicePrompt {
+public:
+    DevicePrompt(ggml_backend_t backend, int64_t width, int64_t capacity)
+        : backend_(backend), width_(width), capacity_(capacity) {
+        context_.reset(ggml_init({ggml_tensor_overhead(), nullptr, true}));
+        if (!context_) { throw std::runtime_error("failed to allocate device prompt metadata"); }
+        values_ = ggml_new_tensor_2d(context_.get(), GGML_TYPE_F32, width, capacity);
+        buffer_ = ggml_backend_alloc_ctx_tensors(context_.get(), backend);
+        if (!buffer_) { throw std::runtime_error("failed to allocate device prompt"); }
+    }
+    ~DevicePrompt() {
+        ggml_backend_synchronize(backend_);
+        ggml_backend_buffer_free(buffer_);
+    }
+    int64_t capacity() const { return capacity_; }
+
+    ggml_tensor * prepare(const GreedyQwenDecoderRuntime::Prompt & prompt,
+                          const std::vector<bool> & injected, const std::vector<float> & text) {
+        const auto & injection = prompt.injection;
+        views_.reset(ggml_init({ggml_tensor_overhead() * (2 * injection.positions.size() + 2), nullptr, true}));
+        if (!views_) { throw std::runtime_error("failed to allocate device prompt views"); }
+        // Both cached text and borrowed encoder storage must outlive queued copies,
+        // including an exception before every row has been submitted.
+        struct Drain {
+            ggml_backend_t backend;
+            ~Drain() { ggml_backend_synchronize(backend); }
+        } drain{backend_};
+        const size_t row_bytes = static_cast<size_t>(width_) * sizeof(float);
+        size_t text_row = 0;
+        for (size_t row = 0; row < injected.size();) {
+            if (injected[row]) { ++row; continue; }
+            const size_t begin = row;
+            while (row < injected.size() && !injected[row]) { ++row; }
+            ggml_backend_tensor_set_async(backend_, values_, text.data() + text_row * width_,
+                                          begin * row_bytes, (row - begin) * row_bytes);
+            text_row += row - begin;
+        }
+        for (size_t row = 0; row < injection.positions.size();) {
+            const size_t begin = row++;
+            while (row < injection.positions.size() &&
+                   injection.positions[row] == injection.positions[row - 1] + 1) { ++row; }
+            auto * source = view(injection.device_values, begin, row - begin);
+            auto * destination = view(values_, injection.positions[begin], row - begin);
+            ggml_backend_tensor_copy_async(backend_, backend_, source, destination);
+        }
+        return view(values_, 0, prompt.input_ids.size());
+    }
+
+private:
+    ggml_tensor * view(ggml_tensor * tensor, size_t start, size_t count) {
+        auto * result = ggml_view_2d(views_.get(), tensor, width_, static_cast<int64_t>(count),
+                                    width_ * sizeof(float), start * width_ * sizeof(float));
+        if (ggml_backend_view_init(result) != GGML_STATUS_SUCCESS) {
+            throw std::runtime_error("failed to initialize device prompt view");
+        }
+        return result;
+    }
+    ggml_backend_t backend_;
+    int64_t width_;
+    int64_t capacity_;
+    std::unique_ptr<ggml_context, GgmlContextDeleter> context_;
+    ggml_backend_buffer_t buffer_ = nullptr;
+    ggml_tensor * values_ = nullptr;
+    std::unique_ptr<ggml_context, GgmlContextDeleter> views_;
+};
