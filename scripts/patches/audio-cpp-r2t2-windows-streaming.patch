+void R2T2ASRSession::trim_rolling_window() {
+    if (!stream_config_.rolling_window || stream_sample_rate_ <= 0) {
+        return;
+    }
+    const size_t sample_rate = static_cast<size_t>(stream_sample_rate_);
+    const size_t max_frames = sample_rate * 16;
+    const size_t trim_target = sample_rate * 8;
+    if (total_decoded_frames_ < window_start_frame_ ||
+        total_decoded_frames_ - window_start_frame_ <= max_frames) {
+        return;
+    }
+
+    const size_t target_frame = window_start_frame_ + trim_target;
+    size_t boundary = window_start_frame_;
+    for (const auto & record : rolling_commits_) {
+        if (record.frame_end > target_frame) {
+            break;
+        }
+        boundary = record.frame_end;
+    }
+    if (boundary == window_start_frame_ && !rolling_commits_.empty()) {
+        // The normal option range is below the 8-second trim interval. Keep
+        // the first complete decode as the boundary for defensive handling of
+        // an externally supplied larger chunk size.
+        boundary = rolling_commits_.front().frame_end;
+    }
+    if (boundary <= window_start_frame_) {
+        return;
+    }
+
+    const size_t frame_count = boundary - window_start_frame_;
+    const size_t channel_stride = static_cast<size_t>(std::max(stream_channels_, 1));
+    if (frame_count > audio_accum_.size() / channel_stride) {
+        throw std::runtime_error("R2T2 rolling stream frame accounting mismatch");
+    }
+    const size_t value_count = frame_count * channel_stride;
+    audio_accum_.erase(audio_accum_.begin(), audio_accum_.begin() + static_cast<std::ptrdiff_t>(value_count));
+    window_start_frame_ = boundary;
+    while (!rolling_commits_.empty() && rolling_commits_.front().frame_end <= boundary) {
+        rolling_commits_.pop_front();
+    }
+}
