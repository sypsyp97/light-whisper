+static void ggml_cuda_mul_mat_serial(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    // Stack views preserve precision and real strides. Slice batches as well so
+    // ordinary dispatch never receives a noncontiguous batched destination.
+    for (int64_t i3 = 0; i3 < src1->ne[3]; ++i3) {
+        for (int64_t i2 = 0; i2 < src1->ne[2]; ++i2) {
+            ggml_tensor weight = *src0;
+            weight.data = (char *) src0->data + (i3 / (src1->ne[3] / src0->ne[3])) * src0->nb[3] +
+                (i2 / (src1->ne[2] / src0->ne[2])) * src0->nb[2];
+            weight.ne[2] = weight.ne[3] = 1;
+            for (int64_t column = 0; column < src1->ne[1]; ++column) {
+                ggml_tensor input = *src1;
+                ggml_tensor output = *dst;
+                input.data = (char *) src1->data + column * src1->nb[1] + i2 * src1->nb[2] + i3 * src1->nb[3];
+                output.data = (char *) dst->data + column * dst->nb[1] + i2 * dst->nb[2] + i3 * dst->nb[3];
+                input.ne[1] = input.ne[2] = input.ne[3] = 1;
+                output.ne[1] = output.ne[2] = output.ne[3] = 1;
+                output.src[0] = &weight;
+                output.src[1] = &input;
+                ggml_mul_mat_set_lowering(&output, GGML_MUL_MAT_LOWERING_DEFAULT);
+                ggml_cuda_mul_mat(ctx, &weight, &input, &output);
+            }
+        }
+    }
+}
+
+void ggml_backend_cuda_context::mul_mat_exact_head(const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    const int cc = ggml_cuda_info().devices[device].cc;
+    const bool eligible = GGML_CUDA_CC_IS_NVIDIA(cc) &&
+        src0->type == GGML_TYPE_F16 && src1->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32 &&
+        ggml_get_op_params_i32(dst, 0) == GGML_PREC_DEFAULT && src1->ne[1] == 4 &&
+        ggml_is_matrix(src0) && ggml_is_matrix(src1) && ggml_is_matrix(dst) &&
+        ggml_is_contiguous(src0) && ggml_is_contiguous(src1) && ggml_is_contiguous(dst) &&
+        !ggml_backend_buft_is_cuda_split(src0->buffer->buft) &&
+        !ggml_backend_buft_is_cuda_split(src1->buffer->buft) &&
+        !ggml_backend_buft_is_cuda_split(dst->buffer->buft) &&
+        ggml_cuda_should_use_mmvf(src0->type, cc, src0->ne, src0->nb, 1);
+    if (!eligible || (exact_head_plan.k != 0 &&
+        (exact_head_plan.k != src0->ne[0] || exact_head_plan.vocab != src0->ne[1]))) {
+        ggml_cuda_mul_mat_serial(*this, src0, src1, dst);
+        return;
+    }
+
+    if (exact_head_plan.k == 0) {
+        const cudaStream_t current_stream = stream();
+        cudaStreamCaptureStatus capture;
+        CUDA_CHECK(cudaStreamIsCapturing(current_stream, &capture));
+        if (capture != cudaStreamCaptureStatusNone) {
+            ggml_cuda_mul_mat_serial(*this, src0, src1, dst);
+            return;
+        }
+
+        // Compare the entire output on this first input before timing. This is
+        // a device/shape sanity check, not a proof for all subsequent inputs.
+        const size_t elements = ggml_nelements(dst);
+        const size_t bytes = elements * sizeof(float);
+        std::vector<uint32_t> serial_bits(elements), grouped_bits(elements);
+        ggml_cuda_mul_mat_serial(*this, src0, src1, dst);
+        CUDA_CHECK(cudaMemcpyAsync(serial_bits.data(), dst->data, bytes, cudaMemcpyDeviceToHost, current_stream));
+        ggml_cuda_mul_mat_vec_f(*this, src0, src1, nullptr, dst);
+        CUDA_CHECK(cudaMemcpyAsync(grouped_bits.data(), dst->data, bytes, cudaMemcpyDeviceToHost, current_stream));
+        CUDA_CHECK(cudaStreamSynchronize(current_stream));
+        bool parity = true;
+        for (size_t i = 0; i < elements; ++i) {
+            parity &= serial_bits[i] == grouped_bits[i];
+        }
+
+        bool grouped = false;
+        if (parity) {
+            cudaEvent_t begin, end;
+            CUDA_CHECK(cudaEventCreate(&begin));
+            CUDA_CHECK(cudaEventCreate(&end));
+            double serial_ms = 0.0, grouped_ms = 0.0;
+            bool valid = true;
+            // Two samples per path, AB then BA, after the parity warmup.
+            for (int sample = 0; sample < 4; ++sample) {
+                const bool measure_grouped = sample == 1 || sample == 2;
+                CUDA_CHECK(cudaEventRecord(begin, current_stream));
+                if (measure_grouped) {
+                    ggml_cuda_mul_mat_vec_f(*this, src0, src1, nullptr, dst);
+                } else {
+                    ggml_cuda_mul_mat_serial(*this, src0, src1, dst);
+                }
+                CUDA_CHECK(cudaEventRecord(end, current_stream));
+                CUDA_CHECK(cudaEventSynchronize(end));
+                float elapsed_ms;
+                CUDA_CHECK(cudaEventElapsedTime(&elapsed_ms, begin, end));
+                valid &= std::isfinite(elapsed_ms) && elapsed_ms > 0.0f;
+                (measure_grouped ? grouped_ms : serial_ms) += elapsed_ms;
+            }
+            CUDA_CHECK(cudaEventDestroy(begin));
+            CUDA_CHECK(cudaEventDestroy(end));
+            grouped = valid && 100.0 * grouped_ms <= 95.0 * serial_ms;
+        }
+        exact_head_plan = {src0->ne[0], src0->ne[1], grouped};
+    }
+
+    // Always write the selected output after calibration, including rejection.
+    if (exact_head_plan.grouped) {
+        ggml_cuda_mul_mat_vec_f(*this, src0, src1, nullptr, dst);
+    } else {
+        ggml_cuda_mul_mat_serial(*this, src0, src1, dst);
+    }
+}
