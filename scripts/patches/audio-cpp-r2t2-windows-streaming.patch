+std::string R2T2ASRSession::build_rolling_prefix() const {
+    std::string body;
+    for (const auto & record : rolling_commits_) {
+        body += record.delta;
+    }
+    body = truncate_at_pipe(body);
+    if (force_language_.empty() && !language_.empty()) {
+        return std::string(kLanguagePrefix) + language_ + kAsrTextTag + body;
+    }
+    if (force_language_.empty() && !rolling_metadata_prefix_.empty()) {
+        // The model may produce a transcript with no detected language. Keep
+        // its actual metadata/tag so committed text is not fed back as metadata.
+        return rolling_metadata_prefix_ + body;
+    }
+    return body;
